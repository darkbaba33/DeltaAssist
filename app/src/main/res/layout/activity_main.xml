<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#121212">

    <TextView android:text="BuseCracker - Otomatik Analiz" android:textColor="#00FFCC" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Analiz etmek istediginiz .apk veya .so dosyasini secin:" android:textColor="#FFFFFF" android:layout_marginBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btn_select_file" android:text="Dosya Sec (.apk / .so)" android:backgroundTint="#00FFCC" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tv_status" android:text="Durum: Bekleniyor..." android:textColor="#FFCC00" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#1E1E1E" android:padding="8dp">
        <TextView android:id="@+id/tv_results" android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="monospace" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
